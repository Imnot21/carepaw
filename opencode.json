{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": ["npx", "-y", "@browsermcp/mcp@latest"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": "C:\\Users\\six6six\\.config\\opencode\\memory\\memory.jsonl"
      }
    },
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server", "--flutter-sdk", "C:\\Users\\six6six\\Desktop\\flutter"],
      "enabled": true
    },
    "mobile-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "enabled": true
    }
  }
}
