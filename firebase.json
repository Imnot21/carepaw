{
    "firestore":  {
                      "database":  "(default)",
                      "location":  "asia-southeast1",
                      "rules":  "firestore.rules",
                      "indexes":  "firestore.indexes.json"
                  },
    "functions":  {
                      "source":  "functions",
                      "codebase":  "default",
                      "runtime":  "nodejs20"
                  },
    "emulators":  {
                      "firestore":  {
                                        "port":  8080
                                    },
                      "ui":  {
                                 "enabled":  true
                             }
                  },
    "hosting":  {
                    "public":  "build/web",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                }
}
