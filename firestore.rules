rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Allow authenticated users to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow authenticated users to update their own profile
      allow update: if request.auth != null && request.auth.uid == userId;

      // Allow creation only by the user themselves (doc ID = their UID)
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.role in ['PET_OWNER', 'VETERINARIAN', 'STAFF', 'ADMIN']
        && request.resource.data.localUserId is int
        && request.resource.data.isActive is bool;

      // Deny delete
      allow delete: if false;
    }

    // ============================================
    // ALLOW READ BY EMAIL FOR SYNC
    // ============================================
    // The AuthSyncService queries users by email to find existing records
    match /users/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || resource.data.email == request.auth.token.email);
    }
  }
}