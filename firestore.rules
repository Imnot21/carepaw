rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // TEST-ONLY RULES — Firestore-first migration bring-up.
    // Any authenticated user may read/write any document so the
    // admin user-management page (list all users, create accounts,
    // change roles, toggle active) and the int-id counter
    // (counters/userIds) work end-to-end.
    //
    // DO NOT ship. Replace with firestore.rules.prod (the previously
    // active rules, preserved verbatim) before any real deployment.
    // ============================================================
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}