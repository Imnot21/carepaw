rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----------------------------------------------------------
    // CarePaw — PRODUCTION Firestore Rules
    // ----------------------------------------------------------
    // These rules enforce:
    //   • Users can read profiles (directory needed for vet names/lists)
    //     but only create/update their own; admins manage all users
    //   • Pet owners can read pets and create/update their own pets
    //   • Appointments: owners CRUD their own, clinic staff manage all
    //   • Medical records: append-only, clinic creates, owners/vets read
    //   • Queue entries: readable by any signed-in user (the owner screen
    //     needs the whole queue to compute line position; entries carry no
    //     owner PII), clinic staff manage state
    //   • Inventory: staff/vets read, staff write
    //   • Notifications: recipients and clinic staff manage them
    //   • Audit logs: admins only
    //   • Counters: any signed-in user (ID sequences for their own writes)
    //
    // Query provability: Firestore denies a LIST query unless its filters
    // prove the rule for every document it could return. Doc-id lookups
    // (where('id', isEqualTo: x)) prove nothing about ownership, so pet-owner
    // callers add an owner-id filter in the repository layer (CallerScope)
    // and rules compare it with getCurrentUserId().
    // ----------------------------------------------------------

    // ---- Helpers ----
    //
    // IMPORTANT: a Firestore rule expression that raises an error DENIES the
    // request outright — even when a sibling `allow` clause would otherwise
    // permit it. Every helper that reads the caller's profile must therefore
    // guard with exists() first: during registration the Auth user exists but
    // its users/{uid} document does not, and an unguarded get(...).data read
    // would fail and block the account from ever being created.

    function isAuthenticated() {
      return request.auth != null;
    }

    // True once the caller has a profile document. False during registration.
    function hasProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    // Paper-aligned: only two sides — pet owners and the Owner/Admin
    // (single clinic operator). Old STAFF/VETERINARIAN/ADMIN values are
    // not provisioned in this build.
    function isOwnerAdmin() {
      return currentRole() == 'OWNER_ADMIN';
    }

    function isClinicStaff() {
      return isOwnerAdmin();
    }

    // The app-facing surrogate int id. Returns -1 when no profile exists yet so
    // ownership comparisons simply evaluate false instead of erroring.
    function getCurrentUserId() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.id
        : -1;
    }

    function getCurrentFirebaseUid() {
      return request.auth.uid;
    }

    // ---- Users collection ----
    match /users/{uid} {
      // Self-service registration: a user creates only their own profile.
      // This is the path registration takes, so it must not depend on a role
      // check — the profile being created is what supplies the role.
      // Owner/Admin may also provision a profile for an account just created
      // (the "create account" flow runs under the operator's session,
      // not the new user's).
      allow create: if isAuthenticated()
                    && request.resource.data.firebaseUid == uid
                     && request.resource.data.role in ['PET_OWNER', 'OWNER_ADMIN']
                    && (request.auth.uid == uid || isOwnerAdmin());
      // Read is open to signed-in users: appointment forms need the
      // veterinarian directory, and detail views resolve clinician names by
      // int id (a query that cannot prove ownership). Writes stay locked.
      allow read: if isAuthenticated();
      allow update: if isOwnerAdmin() || (isAuthenticated() && request.auth.uid == uid);
      // Hard deletion happens only via the deleteUser Cloud Function
      // (Admin SDK bypasses these rules).
      allow delete: if false;
    }

    // ---- Pets collection ----
    match /pets/{petId} {
      // Readable by any signed-in user: pet detail screens look pets up by
      // their integer id, which a query cannot prove ownership from, and pet
      // documents carry no owner PII beyond the owner's int id.
      allow read: if isAuthenticated();
      // Create: `resource` is null for creates, so ownership must be checked
      // against `request.resource` instead — using `resource.data` here
      // would deny every owner-side pet creation.
      allow create: if isAuthenticated() &&
        (isClinicStaff() || request.resource.data.ownerId == getCurrentUserId());
      allow update, delete: if isAuthenticated() &&
        (isClinicStaff() || resource.data.ownerId == getCurrentUserId());
    }

    // ---- Appointments collection ----
    match /appointments/{appointmentId} {
      // Owner: create/read their own
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == getCurrentUserId();
      allow read: if isAuthenticated() &&
        (isClinicStaff() ||
         resource.data.ownerId == getCurrentUserId() ||
         resource.data.veterinarianId == getCurrentUserId());

      // Veterinarian and staff can update appointment status and related fields.
      allow update: if isAuthenticated() &&
        (isClinicStaff() ||
         resource.data.ownerId == getCurrentUserId());

      // Owner/Admin: full
      allow write: if isOwnerAdmin();
    }

    // ---- Medical Records collection ----
    match /medicalRecords/{recordId} {
      // Append-only: create allowed, update/delete denied.
      // Owners reach their records through the denormalized `petOwnerId`
      // field, which the repository stamps on every write and filters on for
      // pet-owner callers.
      allow create: if isAuthenticated() &&
        (isClinicStaff());
      allow read: if isAuthenticated() &&
        (isClinicStaff() ||
         resource.data.petOwnerId == getCurrentUserId());
      // No update, no delete — medical records are immutable
      allow update, delete: if false;
    }

    // ---- Vaccinations subcollection ----
    match /medicalRecords/{recordId}/vaccinations/{vaccinationId} {
      allow create: if isAuthenticated() &&
        (isClinicStaff());
      allow read: if isAuthenticated() &&
        (isClinicStaff() ||
         resource.data.petOwnerId == getCurrentUserId());
      allow update, delete: if false;
    }

    // ---- Inventory collection ----
    match /inventoryItems/{itemId} {
      // Owner/Admin: read + write (stock changes)
      allow read: if isAuthenticated() && (isClinicStaff());
      allow write: if isAuthenticated() && (isOwnerAdmin());
    }

    // ---- Inventory Batches ----
    match /inventoryBatches/{batchId} {
      allow read: if isAuthenticated() && (isClinicStaff());
      allow write: if isAuthenticated() && (isOwnerAdmin());
    }

    // ---- Inventory Transactions ----
    match /inventoryTransactions/{transactionId} {
      allow read: if isAuthenticated() && (isClinicStaff());
      allow create: if isAuthenticated() && (isOwnerAdmin());
      allow update, delete: if false;
    }

    // ---- Prescriptions ----
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() &&
        (resource.data.petOwnerId == getCurrentUserId() ||
         resource.data.veterinarianId == getCurrentUserId() ||
         isOwnerAdmin());
      allow create: if isAuthenticated() && (isOwnerAdmin());
      allow update: if isAuthenticated() && (isOwnerAdmin()) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // ---- Queue Entries ----
    match /queueEntries/{queueId} {
      // Readable by any signed-in user: the owner queue screen fetches the
      // active queue to compute the caller's line position and filters to
      // their own entries client-side. Entries hold operational data only
      // (position/status/room/notes) — no owner or pet PII.
      allow read: if isAuthenticated();
      // The Owner/Admin manages queue state.
      allow create, update: if isAuthenticated() &&
        (isClinicStaff());
      allow delete: if isOwnerAdmin();
    }

    // ---- Notifications ----
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isClinicStaff());
      // Clinic staff target any user; users may send one only to themselves
      // (the in-app "Test Notification" action).
      allow create: if isAuthenticated() &&
        (isClinicStaff() || request.resource.data.userId == getCurrentUserId());
      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isClinicStaff());
    }

    // ---- Notification Preferences ----
    // Doc IDs are the app-facing int user id as a string (e.g. "1").
    match /notificationPreferences/{userKey} {
      allow read: if isAuthenticated() &&
        (resource == null ||
         (string(resource.data.userId) == userKey &&
          resource.data.userId == getCurrentUserId()));
      allow write: if isAuthenticated() &&
        string(request.resource.data.userId) == userKey &&
        request.resource.data.userId == getCurrentUserId();
    }

    // ---- Scan Records ----
    match /scanRecords/{scanId} {
      // Staff/vets manage scanning; scan pages are clinic-facing.
      allow read: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isClinicStaff());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isClinicStaff());
    }

    // ---- Audit Logs ----
    match /auditLogs/{logId} {
      // Owner/Admin only — write-only in practice, but allow read for the
      // (hidden) audit UI
      allow read, write: if isOwnerAdmin();
    }

    // ---- Sync Metadata ----
    match /syncMetadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOwnerAdmin();
    }

    // ---- Device Info ----
    match /deviceInfo/{deviceId} {
      allow read, write: if isAuthenticated() &&
        getCurrentFirebaseUid() == deviceId;
    }

    // ---- Sync Conflicts ----
    match /syncConflicts/{conflictId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isOwnerAdmin());
      allow write: if isOwnerAdmin();
    }

    // ---- Counters (int-id sequences) ----
    match /counters/{counterId} {
      // ID sequences hold no data — only an incrementing integer. Every
      // signed-in user must be able to allocate ids for the records they
      // create (registration, pets, appointments, scans, notifications...),
      // so this is intentionally open to authenticated callers.
      allow read, write: if isAuthenticated();
    }

    // ---- Deny all other ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
