rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ----------------------------------------------------------
    // CarePaw — PRODUCTION Firestore Rules
    // ----------------------------------------------------------
    // These rules enforce:
    //   • Users can read/write their own profile (users/{uid})
    //   • Admins can manage all users
    //   • Pet owners can read/write their own pets
    //   • Veterinarians can read/write pets of their assigned appointments
    //   • Staff can read/write queue entries for check-in flow
    //   • Medical records: append-only, owners/vets can read, vets create
    //   • Inventory: staff/vets read, staff write
    //   • Audit logs: admins write, admins read
    //   • Counters: admin-only (for int-id sequences)
    // ----------------------------------------------------------

    // ---- Helpers ----
    //
    // IMPORTANT: a Firestore rule expression that raises an error DENIES the
    // request outright — even when a sibling `allow` clause would otherwise
    // permit it. Every helper that reads the caller's profile must therefore
    // guard with exists() first: during registration the Auth user exists but
    // its users/{uid} document does not, and an unguarded get(...).data read
    // would fail and block the account from ever being created.

    function isAuthenticated() {
      return request.auth != null;
    }

    // True once the caller has a profile document. False during registration.
    function hasProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isAdmin() {
      return currentRole() == 'ADMIN';
    }

    function isVeterinarian() {
      return currentRole() == 'VETERINARIAN';
    }

    function isStaff() {
      return currentRole() == 'STAFF';
    }

    function isPetOwner() {
      return currentRole() == 'PET_OWNER';
    }

    function isClinicStaff() {
      return isStaff() || isVeterinarian() || isAdmin();
    }

    // The app-facing surrogate int id. Returns -1 when no profile exists yet so
    // ownership comparisons simply evaluate false instead of erroring.
    function getCurrentUserId() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.id
        : -1;
    }

    function getCurrentFirebaseUid() {
      return request.auth.uid;
    }

    function isPetOwnerOf(petOwnerId) {
      return getCurrentUserId() == petOwnerId;
    }

    function isVeterinarianOf(petId) {
      // The application stores veterinarian access at the role level; this
      // helper is kept for compatibility with older rules while the app uses
      // the broader authenticated-clinic-role checks below.
      return isVeterinarian();
    }

    function isOwnerOrVetOfPet(petOwnerId, petId) {
      return isPetOwnerOf(petOwnerId) || isVeterinarianOf(petId);
    }

    // ---- Users collection ----
    match /users/{uid} {
      // Self-service: a user creates and maintains only their own profile.
      // This is the path registration takes, so it must not depend on a role
      // check — the profile being created is what supplies the role.
      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.firebaseUid == request.auth.uid
                    && request.resource.data.role in ['ADMIN', 'VETERINARIAN', 'STAFF', 'PET_OWNER'];
      allow read, update: if isAuthenticated() && request.auth.uid == uid;

      // Admin: full access to every other user's document.
      allow read, write: if isAdmin();

      // Deletion only via Cloud Function (admin) — not directly here.
      allow delete: if false;
    }

    // ---- Pets collection ----
    match /pets/{petId} {
      // Owner: full CRUD on their pets
      allow read, write: if isAuthenticated() &&
        (isAdmin() || isStaff() || isVeterinarian() || resource.data.ownerId == getCurrentUserId());
    }

    // ---- Appointments collection ----
    match /appointments/{appointmentId} {
      // Owner: create/read their own
      allow create: if isAuthenticated() &&
        request.resource.data.ownerId == getCurrentUserId();
      allow read: if isAuthenticated() &&
        (isAdmin() || isStaff() || isVeterinarian() ||
         resource.data.ownerId == getCurrentUserId() ||
         resource.data.veterinarianId == getCurrentUserId());

      // Veterinarian and staff can update appointment status and related fields.
      allow update: if isAuthenticated() &&
        (isAdmin() || isStaff() || isVeterinarian() ||
         resource.data.ownerId == getCurrentUserId());

      // Admin: full
      allow write: if isAdmin();
    }

    // ---- Medical Records collection ----
    match /medicalRecords/{recordId} {
      // Append-only: create allowed, update/delete denied
      allow create: if isAuthenticated() &&
        (isVeterinarian() || isStaff() || isAdmin());
      allow read: if isAuthenticated() &&
        (isAdmin() || isStaff() || isVeterinarian() ||
         resource.data.petOwnerId == getCurrentUserId());
      // No update, no delete — medical records are immutable
      allow update, delete: if false;
    }

    // ---- Vaccinations subcollection ----
    match /medicalRecords/{recordId}/vaccinations/{vaccinationId} {
      allow create: if isAuthenticated() &&
        (isVeterinarian() || isStaff() || isAdmin());
      allow read: if isAuthenticated() &&
        (isAdmin() || isStaff() || isVeterinarian() ||
         resource.data.petOwnerId == getCurrentUserId());
      allow update, delete: if false;
    }

    // ---- Inventory collection ----
    match /inventoryItems/{itemId} {
      // Staff/vets: read; Staff: write (stock changes)
      allow read: if isAuthenticated() && (isStaff() || isVeterinarian() || isAdmin());
      allow write: if isAuthenticated() && (isStaff() || isAdmin());
    }

    // ---- Inventory Batches ----
    match /inventoryBatches/{batchId} {
      allow read: if isAuthenticated() && (isStaff() || isVeterinarian() || isAdmin());
      allow write: if isAuthenticated() && (isStaff() || isAdmin());
    }

    // ---- Inventory Transactions ----
    match /inventoryTransactions/{transactionId} {
      allow read: if isAuthenticated() && (isStaff() || isVeterinarian() || isAdmin());
      allow create: if isAuthenticated() && (isStaff() || isAdmin());
      allow update, delete: if false;
    }

    // ---- Prescriptions ----
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() &&
        (resource.data.petOwnerId == getCurrentUserId() ||
         resource.data.veterinarianId == getCurrentUserId() ||
         isAdmin());
      allow create: if isAuthenticated() && isVeterinarian();
      allow update: if isAuthenticated() && isVeterinarian() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // ---- Queue Entries ----
    match /queueEntries/{queueId} {
      // Owner: read own queue entries
      allow read: if isAuthenticated() &&
        (isAdmin() || isStaff() || isVeterinarian() ||
         resource.data.petOwnerId == getCurrentUserId());
      // Staff and admins manage queue state; veterinarians can also update status.
      allow create, update: if isAuthenticated() &&
        (isAdmin() || isStaff() || isVeterinarian());
      allow delete: if isAdmin();
    }

    // ---- Notifications ----
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == getCurrentUserId();
      allow create: if isAuthenticated() && (isStaff() || isVeterinarian() || isAdmin());
      allow update: if isAuthenticated() && resource.data.userId == getCurrentUserId();
    }

    // ---- Scan Records ----
    match /scanRecords/{scanId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ---- Audit Logs ----
    match /auditLogs/{logId} {
      // Admins only — write-only in practice, but allow read for admin UI
      allow read, write: if isAdmin();
    }

    // ---- Sync Metadata ----
    match /syncMetadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ---- Device Info ----
    match /deviceInfo/{deviceId} {
      allow read, write: if isAuthenticated() &&
        getCurrentFirebaseUid() == deviceId;
    }

    // ---- Sync Conflicts ----
    match /syncConflicts/{conflictId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == getCurrentUserId() || isAdmin());
      allow write: if isAdmin();
    }

    // ---- Counters (int-id sequences) ----
    match /counters/{counterId} {
      // userIds counter: any authenticated user may increment it so that
      // registration can allocate a unique id. Every other counter is
      // provisioned and advanced by clinic roles.
      allow read: if isAuthenticated() && (counterId == 'userIds' || isClinicStaff());
      allow write: if isAuthenticated() && (counterId == 'userIds' || isClinicStaff());
    }

    // ---- Deny all other ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}